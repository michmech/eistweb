<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <title><%=L('#siteshortname')%></title>
    
    <link rel="stylesheet" href="/icons.css"/>
    <link rel="stylesheet" href="/login/styles.css"/>
  </head>
  <body>
    <main>
      
      <div class="container">
        <%if(loginFailed){%>
          <div class="failed">
            <%=L("#loginfailed")%>
          </div>  
        <%}%>
        <form method="post" action="">
          <input type="hidden" name="redirTo" value="<%=redirTo%>"/>
          <div class="line">
            <label>
              <span class="label"><%=L("#username")%></span>
              <input name="username" value="<%=username%>"/>
            </label>
          </div>
          <div class="line">
            <label>
              <span class="label"><%=L("#password")%></span>
              <input name="password" type="password" value="<%=password%>"/>
            </label>
          </div>
          <div class="line doubleSpaceBefore">
            <button type="submit"><%=L("#login")%></button>
          </div>
        </form>
      </div>

    </main>
  </body>
</html>
