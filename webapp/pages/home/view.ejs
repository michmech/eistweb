<!DOCTYPE html>
<html lang="<%=uilang%>">
  <head>
    <%-include("../../includes/headContent/view.ejs", this)%>
    <link rel="stylesheet" href="/home/styles.css"/>
    <script src="/home/scripts.js"></script>
  </head>
  <body>
    <%-include("../../includes/header/view.ejs", this)%>
    <main>
      
      <div class="hero">
        <h1>The Future of Gaelic in the Digital Age</h1>
        <div class="slogan">
          ÈIST is building speech & language technology for Scottish Gaelic.
          <a href="#">About ÈIST...</a>
        </div>
      </div>

      <div class="demoboxline">
        <div class="demobox of2">
          <div class="top">
            <h2>Automatic Speech Recognition</h2>
            <div class="blurb">Convert Gaelic speech to text</div>
          </div>
          <div class="middle"></div>
          <div class="bottom">
            <a href="#">More about Gaelic speech-to-text technology...</a>
          </div>
        </div>
        <div class="demobox of2">
          <div class="top">
            <h2>Opening the Well</h2>
            <div class="blurb">Help transcribe Scotland’s oral heritage</div>
