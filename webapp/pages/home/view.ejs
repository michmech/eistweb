<!DOCTYPE html>
<html lang="<%=uilang%>">
  <head>
    <%-include("../../includes/headContent/view.ejs", this)%>
    <link rel="stylesheet" href="/home/styles.css"/>
    <script src="/home/scripts.js"></script>
  </head>
  <body>
    <%-include("../../includes/header/view.ejs", this)%>
    <main>
      
      <div class="hero">
        <h1><%=L("#hometitle")%></h1>
        <div class="slogan">
          <%=L("#homesubtitle")%>
          <a href="/<%-uilang%>/<%-L('#aboutslug')%>"><%=L("#about")%>...</a>
        </div>
      </div>

      <div class="demoboxline of2">
        <div class="demobox">
          <div class="top">
            <h2><%=L("#openingthewell")%></h2>
            <div class="blurb"><%=L("#openingthewellslogan")%></div>
          </div>
          <div class="middle">
            <a class="iconrow of2" title="<%=L('#visitopeningthewell')%>" target="_blank" href="https://fosgladh.tobarandualchais.co.uk/<%-uilang%>">
              <div class="iconbox">
                <span class="icon clock"></span>
                <span class="num">3:35</span>
                <span class="caption"><%=L("#hourminustessofar")%></span>
              </div>
              <div class="iconbox">
                <span class="icon keyboard"></span>
                <span class="num">37,399</span>
                <span class="caption"><%=L("#wordssofar")%></span>
              </div>
            </a>
          </div>
          <div class="bottom">
            <a target="_blank" href="https://fosgladh.tobarandualchais.co.uk/<%-uilang%>/<%-L('claraich|register')%>"><%=L("#openingthewellcalltoaction")%>...</a>
          </div>
        </div>
        <div class="demobox">
          <div class="top">
            <h2><%=L("#asr")%></h2>
            <div class="blurb"><%=L("#asrtagline")%></div>
          </div>
          <div class="middle">
            <a class="iconrow of1" target="_blank" href="https://huggingface.co/spaces/eist-edinburgh/scottish-gaelic-subtitling">
              <div class="iconbox">
                <span class="icon circle-play"></span>
                <span class="caption lonely"><%=L("#subtitleavideo")%></span>
                <span class="button"><%=L("#starthere")%></span>
              </div>
            </a>
          </div>
          <div class="bottom">
            <a href="/<%-uilang%>/<%-L('#asrslug')%>"><%=L("#moreaboutasr")%>...</a>
          </div>
        </div>
      </div>

      <div class="demoboxline of1">
        <div class="demobox">
          <div class="top">
            <h2><%=L("#llmscoreboard")%></h2>
            <div class="blurb"><%=L("#llmtagline")%></div>
          </div>
          <div class="middle">
            <%-include("../../includes/scorecard/view.ejs", this)%>
            <div class="reddot">
              <a href="/edit?nickname=llmscoreboard&returnUrl=<%=pageUrls[uilang]%>"><%=L("#editthisdata")%></a>
            </div>
          </div>
          <div class="bottom">
            <a href="/<%-uilang%>/<%-L('#llmslug')%>"><%=L("#llmcalltoaction")%>...</a>
          </div>
        </div>
      </div>

      <ul class="callboxline">
        <li class="callbox">
          <a href="/<%-uilang%>/<%-L('#aboutslug')%>"><%=L('#about')%></a>
          <div class="blurb"><%=L('#abouttagline')%></div>
        </li>
        <li class="callbox">
          <a href="/<%-uilang%>/<%-L('#teampartnersslug')%>"><%=L('#teampartners')%></a>
          <div class="blurb"><%=L('#teampartnerstagline')%></div>
        </li>
        <li class="callbox">
          <a href="/<%-uilang%>/<%-L('#resultspubsslug')%>"><%=L('#resultspubs')%></a>
          <div class="blurb"><%=L('#resultspubstagline')%></div>
        </li>
      </ul>

    </main>
    <%-include("../../includes/footer/view.ejs", this)%>
  </body>
</html>
