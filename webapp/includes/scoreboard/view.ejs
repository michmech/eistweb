<link rel="stylesheet" href="/scoreboard/styles.css" />
<table class="scoreboard">
  <tbody>
    <%scoreboard.map(row => {%>
      <%if(row.modelName == "human"){%>
        <tr>
          <td class="rank"></td>
          <td class="modelName"><%=L('#humanbaseline')%></td>
          <td class="score"><div class="baseline"><div class="inside" style="width:<%=row.score%>%"></div></div></td>
        </tr>
      <%} else {%>
        <tr>
          <td class="rank"><%=row.rank%></td>
          <td class="modelName"><%=row.modelName%></td>
          <td class="score"><div class="thermo"><div class="inside grade<%=row.grade%>" style="width:<%=row.score%>%"><%=row.score%>%</div></div></td>
        </tr>
      <%}%>
    <%});%>
  </tbody>
</table>